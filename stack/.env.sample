# Sample environment file for docker-compose
# Copy this file to .env and fill in your actual values

# Host storage paths used for bind mounts
# Use absolute paths and do not include a trailing slash
CONFIG_ROOT=/volume1/dkrcfg
DOWNLOADS_PATH=/volume1/downloads
TV_PATH=/volume1/TV
MOVIES_PATH=/volume1/Movies
MUSIC_PATH=/volumeUSB2/usbshare
COMICS_PATH=/volumeUSB1/usbshare/comics
BOOKS_PATH=/volumeUSB1/usbshare/books

# VPN Configuration (Gluetun with Private Internet Access)
OPENVPN_USER=your_pia_username
OPENVPN_PASSWORD=your_pia_password


# API keys used by Unpackerr. Find each in the app's Settings > General.
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=

# ISO country code expected from the shared Gluetun egress
VPN_EXPECTED_COUNTRY=CH

# Git ref used by the one-shot Recyclarr template sync (branch, tag, or commit)
RECYCLARR_CONFIG_REF=main

# Git ref used by the configuration drift auditor
CONFIG_OPS_REF=main

# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Australia/Sydney

# NOTE: PUID/PGID and all Gluetun VPN options (region, port forwarding,
# DNS blocking, updater) are set directly in docker-compose.yml, not here.
