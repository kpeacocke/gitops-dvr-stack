# Sample environment file for docker-compose
# Copy this file to .env and fill in your actual values

# Host storage paths used for bind mounts
# Use absolute paths and do not include a trailing slash
CONFIG_ROOT=/volume1/dkrcfg
DOWNLOADS_PATH=/volume1/downloads
TV_PATH=/volume1/TV
MOVIES_PATH=/volume1/Movies
MUSIC_PATH=/volumeUSB2/usbshare
COMICS_PATH=/volumeUSB1/usbshare/comics
BOOKS_PATH=/volumeUSB1/usbshare/books

# VPN Configuration (Gluetun with Private Internet Access)
OPENVPN_USER=your_pia_username
OPENVPN_PASSWORD=your_pia_password
VPN_SERVICE_PROVIDER=private internet access
VPN_SERVER_REGIONS=Switzerland
VPN_DNS_SERVERS=1.1.1.1:53,1.0.0.1:53
VPN_HEALTH_TARGETS=1.1.1.1:443,cloudflare.com:443,github.com:443
LAN_SUBNET=192.168.3.0/24

# NAS account used for files written by LinuxServer containers
PUID=1027
PGID=100


# API keys used by Unpackerr. Find each in the app's Settings > General.
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=
NOTIFIARR_API_KEY=

# Kometa secrets remain in Portainer and fill the Git-managed template.
KOMETA_PLEX_URL=https://plex.ambitiouscake.com
KOMETA_PLEX_TOKEN=
KOMETA_TMDB_APIKEY=
KOMETA_TIMES=05:00

# ISO country code expected from the shared Gluetun egress
VPN_EXPECTED_COUNTRY=CH

# Git ref used by the one-shot Recyclarr template sync (branch, tag, or commit)
RECYCLARR_CONFIG_REF=main

# Git ref used by the configuration drift auditor
CONFIG_OPS_REF=main
KOMETA_CONFIG_REF=main

# Native application backup freshness requirement
BACKUP_MAX_AGE_DAYS=8

# Fail the desired-state audit before the shared media pool becomes critically full
MIN_FREE_SPACE_GIB=500

# Recyclarr synchronization schedule
RECYCLARR_CRON_SCHEDULE=0 4 * * *

# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Australia/Sydney

# Port forwarding, DNS blocking, and updater behavior are deliberate compose
# policy; host identity, provider, region, DNS, health targets, and LAN routing
# are deployment parameters above.
